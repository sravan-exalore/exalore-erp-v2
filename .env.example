# ==============================================================================
# Exalore Multi-Tenant ERP Platform — Environment Configuration Template
# ==============================================================================

# Core Django Settings
DJANGO_SECRET_KEY=change-this-in-production-to-a-random-64-character-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database Encryption Key (Fernet Key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TENANT_DB_ENCRYPTION_KEY=

# Central (Default) PostgreSQL Database Credentials
POSTGRES_DB=exalore_default
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Redis & Caching Subsystem
REDIS_URL=redis://localhost:6379/1
CACHE_BACKEND=django.core.cache.backends.redis.RedisCache

# Celery Task Broker
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT Token Lifespans
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Cross-Origin Resource Sharing (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging & Observability
DJANGO_LOG_LEVEL=INFO

